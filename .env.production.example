# Copy to .env.production on the server and fill in the secrets. Never commit .env.production.
APP_ENV=prod
# Public name that points at this server (DNS A record). Caddy gets the certificate for it.
DOMAIN=carecircle.example.com
# 48+ random characters:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Database (the app reaches it as "db" on a private network)
POSTGRES_USER=carecircle
POSTGRES_PASSWORD=
POSTGRES_DB=carecircle

# HTTPS is mandatory in production (cookies, and browsers only allow the microphone on HTTPS)
COOKIE_SECURE=true
SESSION_HOURS=12
APP_TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO

# A hosted DEMO keeps these true (fictional data and the demo accounts). Real patients: set all three to false.
DEMO_MODE=true
SEED_DEMO=true
DEMO_POPULATION=true
DEMO_PASSWORD=
AUTO_COORDINATION=true

# Staged rollout: features not listed are off. "*" turns every shipped feature on.
FEATURES=voice_notes,insights,reminders,progress_report,directory
# Run the scheduler here (only one instance does at a time, enforced by a database lock)
RUN_SCHEDULER=true

# AI (optional, advisory only): see docs/AI.md
GEMINI_API_KEY=
GROQ_API_KEY=
GEMMA_MODEL=gemma-4-31b-it
GEMINI_SPEECH_MODEL=gemini-flash-lite-latest
GROQ_STT_MODEL=whisper-large-v3
GROQ_TEXT_MODEL=openai/gpt-oss-120b
AI_SPEECH_ORDER=groq,gemini
AI_TEXT_ORDER=groq,gemma

# Behind Caddy (docker-compose.prod.yml) this is set for you. On a hosting platform that terminates TLS, set it to * so rate limits see real client IPs.
# FORWARDED_ALLOW_IPS=*
