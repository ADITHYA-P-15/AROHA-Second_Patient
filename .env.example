# Copy to .env for local development. Replace SECRET_KEY outside demos.
APP_ENV=dev
SECRET_KEY=change-me-before-production
DATABASE_URL=postgresql+psycopg://secondpatient:secondpatient@db:5432/secondpatient
APP_TIMEZONE=Asia/Kolkata
DEMO_MODE=true
SEED_DEMO=true
# Also build the larger fictional population (24 patients, families, caretakers, hospital staff, 30 days of history)
DEMO_POPULATION=true
DEMO_PASSWORD=Demo@1234
ESCALATION_TIME_SCALE=1.0
COOKIE_SECURE=false
SESSION_HOURS=12
LOG_LEVEL=INFO
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
GIT_SHA=dev

# AI (optional, advisory only). Keys stay on the server. With no keys the app works as before;
# voice notes are then routed for a person to listen to. Verify with: python scripts/ai_check.py
#   Speech to text: Groq Whisper first, a Gemini model on the Google key as the fallback.
#   Text tasks:     Groq first, Gemma (Google key) as the fallback.
# Gemma models on the Gemini API currently reject audio; list "gemma" in AI_SPEECH_ORDER to try one later.
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-31b-it
GEMINI_SPEECH_MODEL=gemini-flash-lite-latest
GROQ_API_KEY=
# Use large-v3, not -turbo: turbo mislabelled Kannada and Telugu in testing
GROQ_STT_MODEL=whisper-large-v3
GROQ_TEXT_MODEL=openai/gpt-oss-120b
AI_SPEECH_ORDER=groq,gemini
AI_TEXT_ORDER=groq,gemma
AI_TIMEOUT_SECONDS=15
AI_TEXT_TIMEOUT_SECONDS=8
# Only needed behind a proxy:
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GROQ_BASE_URL=https://api.groq.com/openai/v1
