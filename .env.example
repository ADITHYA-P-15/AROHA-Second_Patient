# Copy to .env for local development. Replace SECRET_KEY outside demos.
APP_ENV=dev
SECRET_KEY=change-me-before-production
DATABASE_URL=postgresql+psycopg://secondpatient:secondpatient@db:5432/secondpatient
APP_TIMEZONE=Asia/Kolkata
DEMO_MODE=true
SEED_DEMO=true
# Also build the larger fictional population (24 patients, families, caretakers, hospital staff, 30 days of history)
DEMO_POPULATION=true
DEMO_PASSWORD=Demo@1234
ESCALATION_TIME_SCALE=1.0
COOKIE_SECURE=false
SESSION_HOURS=12
LOG_LEVEL=INFO
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
GIT_SHA=dev

# AI (optional, advisory only). Speech: Gemma first, Groq as fallback. Text tasks: Groq first, Gemma as fallback.
# Keys stay on the server. With no keys the app works as before; voice notes are routed for a person to listen to.
GEMINI_API_KEY=
GEMMA_MODEL=gemma-3n-e4b-it
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
AI_SPEECH_ORDER=gemma,groq
AI_TEXT_ORDER=groq,gemma
# Only needed behind a proxy:
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GROQ_BASE_URL=https://api.groq.com/openai/v1
